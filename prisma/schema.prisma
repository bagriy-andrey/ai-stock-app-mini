generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AiCallStatus {
  SUCCESS
  ERROR
}

enum AssetType {
  STOCK
  ETF
  CRYPTO
}

enum InvestmentIntent {
  LONG_TERM
  TACTICAL
}

enum WatchlistPriority {
  LOW
  MEDIUM
  HIGH
}

enum PortfolioActivityType {
  CASH_DEPOSIT
  CASH_WITHDRAWAL
}

enum PortfolioExchangeType {
  CRYPTO
  STOCK
}

model AiUsageRecord {
  id           String       @id @default(cuid())
  agent        String
  ticker       String?
  model        String
  modelTier    String
  inputTokens  Int?
  outputTokens Int?
  cost         Decimal?     @db.Decimal(12, 6)
  latencyMs    Int?
  status       AiCallStatus
  errorMessage String?
  createdAt    DateTime     @default(now())

  @@index([agent])
  @@index([model])
  @@index([modelTier])
  @@index([createdAt])
}

model Asset {
  id             String          @id @default(cuid())
  symbol         String
  name           String
  assetType      AssetType
  currency       String
  exchange       String?
  provider       String
  providerSymbol String
  sector         String?
  region         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  positions      Position[]
  watchlistItems WatchlistItem[]
  marketPrices   MarketPrice[]

  @@unique([provider, providerSymbol])
  @@index([symbol])
  @@index([assetType])
}

model Portfolio {
  id           String                 @id @default(cuid())
  name         String
  baseCurrency String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  positions    Position[]
  cashBalances CashBalance[]
  activityLogs PortfolioActivityLog[]
  exchanges    PortfolioExchange[]
}

model PortfolioExchange {
  id          String                @id @default(cuid())
  portfolioId String
  name        String
  type        PortfolioExchangeType
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  portfolio   Portfolio             @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, name])
  @@index([portfolioId])
  @@index([type])
}

model Position {
  id               String                    @id @default(cuid())
  portfolioId      String
  assetId          String
  quantity         Decimal                   @db.Decimal(24, 8)
  averageCost      Decimal                   @db.Decimal(24, 8)
  costCurrency     String
  investmentIntent InvestmentIntent
  notes            String?
  openedAt         DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  portfolio        Portfolio                 @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset            Asset                     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  platformHoldings PositionPlatformHolding[]

  @@unique([portfolioId, assetId])
  @@index([portfolioId])
  @@index([assetId])
  @@index([investmentIntent])
}

model PositionPlatformHolding {
  id           String    @id @default(cuid())
  positionId   String
  platform     String
  quantity     Decimal   @db.Decimal(24, 8)
  averageCost  Decimal   @db.Decimal(24, 8)
  costCurrency String
  openedAt     DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  position     Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([positionId, platform])
  @@index([positionId])
  @@index([platform])
}

model CashBalance {
  id          String    @id @default(cuid())
  portfolioId String
  platform    String    @default("Unassigned")
  currency    String
  amount      Decimal   @db.Decimal(24, 8)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, platform, currency])
  @@index([portfolioId])
}

model PortfolioActivityLog {
  id          String                @id @default(cuid())
  portfolioId String
  type        PortfolioActivityType
  platform    String?
  currency    String?
  amount      Decimal?              @db.Decimal(24, 8)
  description String
  createdAt   DateTime              @default(now())
  portfolio   Portfolio             @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, createdAt])
  @@index([type])
}

model WatchlistItem {
  id               String            @id @default(cuid())
  assetId          String            @unique
  investmentIntent InvestmentIntent
  notes            String?
  targetEntryPrice Decimal?          @db.Decimal(24, 8)
  priority         WatchlistPriority @default(MEDIUM)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([investmentIntent])
  @@index([priority])
}

model MarketPrice {
  id             String   @id @default(cuid())
  assetId        String
  price          Decimal  @db.Decimal(24, 8)
  currency       String
  provider       String
  providerSymbol String
  observedAt     DateTime
  ingestedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, observedAt])
  @@index([provider, providerSymbol])
  @@index([ingestedAt])
}
