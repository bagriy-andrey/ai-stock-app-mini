generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AiCallStatus {
  SUCCESS
  ERROR
}

enum AgentRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

enum AgentStance {
  BULLISH
  BEARISH
  NEUTRAL
  MIXED
}

enum AssetType {
  STOCK
  ETF
  CRYPTO
}

enum InvestmentIntent {
  LONG_TERM
  TACTICAL
}

enum WatchlistPriority {
  LOW
  MEDIUM
  HIGH
}

enum PortfolioActivityType {
  CASH_DEPOSIT
  CASH_WITHDRAWAL
  ASSET_BUY
  ASSET_SELL
}

enum PortfolioExchangeType {
  CRYPTO
  STOCK
}

enum ScannerType {
  PORTFOLIO
  WATCHLIST
  OPPORTUNITY
  CRYPTO
  NEWS_EVENT
}

enum ScannerRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

enum ScannerRunTrigger {
  MANUAL
  SCHEDULED
  SYSTEM
}

enum SignalSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SignalDirection {
  POSITIVE
  NEGATIVE
  MIXED
  NEUTRAL
  UNKNOWN
}

model AiUsageRecord {
  id           String       @id @default(cuid())
  agentRunId   String?
  agent        String
  ticker       String?
  model        String
  modelTier    String
  inputTokens  Int?
  outputTokens Int?
  cost         Decimal?     @db.Decimal(12, 6)
  latencyMs    Int?
  status       AiCallStatus
  errorMessage String?
  createdAt    DateTime     @default(now())
  agentRun      AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([agentRunId])
  @@index([agent])
  @@index([model])
  @@index([modelTier])
  @@index([createdAt])
}

model AiModelTierSetting {
  tier         String   @id
  primaryModel String
  modelName    String?
  promptPrice  Decimal? @db.Decimal(18, 12)
  completionPrice Decimal? @db.Decimal(18, 12)
  requestPrice Decimal? @db.Decimal(18, 12)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model Asset {
  id             String          @id @default(cuid())
  symbol         String
  name           String
  assetType      AssetType
  currency       String
  exchange       String?
  provider       String
  providerSymbol String
  sector         String?
  region         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  positions      Position[]
  watchlistItems WatchlistItem[]
  marketPrices   MarketPrice[]
  agentRuns      AgentRun[]
  analysisReports AnalysisReport[]
  discoveryUniverseAssets DiscoveryUniverseAsset[]
  scannerSignals ScannerSignal[]
  marketEvents MarketEvent[]

  @@unique([provider, providerSymbol])
  @@index([symbol])
  @@index([assetType])
}

model Portfolio {
  id           String                 @id @default(cuid())
  name         String
  baseCurrency String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  positions    Position[]
  cashBalances CashBalance[]
  activityLogs PortfolioActivityLog[]
  exchanges    PortfolioExchange[]
  agentRuns    AgentRun[]
}

model PortfolioExchange {
  id          String                @id @default(cuid())
  portfolioId String
  name        String
  type        PortfolioExchangeType
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  portfolio   Portfolio             @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, name])
  @@index([portfolioId])
  @@index([type])
}

model Position {
  id               String                    @id @default(cuid())
  portfolioId      String
  assetId          String
  quantity         Decimal                   @db.Decimal(24, 8)
  averageCost      Decimal                   @db.Decimal(24, 8)
  costCurrency     String
  investmentIntent InvestmentIntent
  notes            String?
  openedAt         DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  portfolio        Portfolio                 @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset            Asset                     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  platformHoldings PositionPlatformHolding[]
  agentRuns        AgentRun[]

  @@unique([portfolioId, assetId])
  @@index([portfolioId])
  @@index([assetId])
  @@index([investmentIntent])
}

model PositionPlatformHolding {
  id           String    @id @default(cuid())
  positionId   String
  platform     String
  quantity     Decimal   @db.Decimal(24, 8)
  averageCost  Decimal   @db.Decimal(24, 8)
  costCurrency String
  openedAt     DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  position     Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([positionId, platform])
  @@index([positionId])
  @@index([platform])
}

model CashBalance {
  id          String    @id @default(cuid())
  portfolioId String
  platform    String    @default("Unassigned")
  currency    String
  amount      Decimal   @db.Decimal(24, 8)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, platform, currency])
  @@index([portfolioId])
}

model PortfolioActivityLog {
  id          String                @id @default(cuid())
  portfolioId String
  type        PortfolioActivityType
  platform    String?
  currency    String?
  amount      Decimal?              @db.Decimal(24, 8)
  description String
  createdAt   DateTime              @default(now())
  portfolio   Portfolio             @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, createdAt])
  @@index([type])
}

model WatchlistItem {
  id               String            @id @default(cuid())
  assetId          String            @unique
  investmentIntent InvestmentIntent
  notes            String?
  targetEntryPrice Decimal?          @db.Decimal(24, 8)
  priority         WatchlistPriority @default(MEDIUM)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  agentRuns        AgentRun[]

  @@index([investmentIntent])
  @@index([priority])
}

model MarketPrice {
  id             String   @id @default(cuid())
  assetId        String
  price          Decimal  @db.Decimal(24, 8)
  currency       String
  provider       String
  providerSymbol String
  observedAt     DateTime
  ingestedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, observedAt])
  @@index([provider, providerSymbol])
  @@index([ingestedAt])
}

model AgentRun {
  id                 String                  @id @default(cuid())
  assetId            String
  portfolioId        String?
  positionId         String?
  watchlistItemId    String?
  requestedIntent    InvestmentIntent
  status             AgentRunStatus          @default(PENDING)
  inputSnapshot      Json
  startedAt          DateTime?
  completedAt        DateTime?
  errorMessage       String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  asset              Asset                   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  portfolio          Portfolio?              @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  position           Position?               @relation(fields: [positionId], references: [id], onDelete: SetNull)
  watchlistItem      WatchlistItem?          @relation(fields: [watchlistItemId], references: [id], onDelete: SetNull)
  report             AnalysisReport?
  reasoningSummaries AgentReasoningSummary[]
  usageRecords       AiUsageRecord[]

  @@index([assetId])
  @@index([portfolioId])
  @@index([positionId])
  @@index([watchlistItemId])
  @@index([requestedIntent])
  @@index([status])
  @@index([createdAt])
}

model AnalysisReport {
  id                  String     @id @default(cuid())
  agentRunId          String     @unique
  assetId             String
  language            String
  title               String
  summary             String
  recommendationLabel String
  confidence          Decimal    @db.Decimal(5, 4)
  riskLevel           String
  timeHorizon         String
  thesis              Json
  opportunities       Json
  risks               Json
  portfolioFit        String
  missingDataWarnings Json
  rawOutput           Json
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  agentRun            AgentRun   @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  asset               Asset      @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([createdAt])
  @@index([recommendationLabel])
  @@index([riskLevel])
}

model AgentReasoningSummary {
  id            String      @id @default(cuid())
  agentRunId    String
  agentName     String
  agentRole     String
  modelTier     String
  model         String?
  promptVersion String
  summary       String
  stance        AgentStance
  confidence    Decimal?    @db.Decimal(5, 4)
  rawOutput     Json
  createdAt     DateTime    @default(now())
  agentRun      AgentRun    @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
  @@index([agentName])
  @@index([stance])
  @@index([createdAt])
}

model DiscoveryUniverse {
  id          String                   @id @default(cuid())
  name        String                   @unique
  description String?
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  assets      DiscoveryUniverseAsset[]

  @@index([isActive])
}

model DiscoveryUniverseAsset {
  id                  String            @id @default(cuid())
  discoveryUniverseId String
  assetId             String
  priority            Int               @default(50)
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  discoveryUniverse   DiscoveryUniverse @relation(fields: [discoveryUniverseId], references: [id], onDelete: Cascade)
  asset               Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([discoveryUniverseId, assetId])
  @@index([assetId])
  @@index([priority])
}

model ScannerRun {
  id                   String           @id @default(cuid())
  scannerType          ScannerType
  status               ScannerRunStatus @default(PENDING)
  trigger              ScannerRunTrigger
  configurationVersion String
  inputScope           Json
  startedAt            DateTime?
  completedAt          DateTime?
  errorMessage         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  signals              ScannerSignal[]

  @@index([scannerType, createdAt])
  @@index([status])
  @@index([trigger])
}

model ScannerSignal {
  id                      String             @id @default(cuid())
  scannerRunId            String
  assetId                 String?
  signalType              String
  severity                SignalSeverity
  direction               SignalDirection
  score                   Decimal            @db.Decimal(8, 4)
  confidence              Decimal            @db.Decimal(5, 4)
  title                   String
  summary                 String
  reasons                 Json
  risks                   Json
  sourceRefs              Json
  dataFreshness           Json
  isDeepAnalysisCandidate Boolean            @default(false)
  suggestedAction         String
  createdAt               DateTime           @default(now())
  scannerRun              ScannerRun         @relation(fields: [scannerRunId], references: [id], onDelete: Cascade)
  asset                   Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  eventLinks              ScannerEventLink[]

  @@index([scannerRunId])
  @@index([assetId])
  @@index([severity])
  @@index([isDeepAnalysisCandidate])
  @@index([score])
}

model MarketEvent {
  id              String             @id @default(cuid())
  dedupeKey       String             @unique
  eventType       String
  occurredAt      DateTime
  detectedAt      DateTime           @default(now())
  sourceProvider  String
  sourceUrl       String?
  sourceTitle     String
  affectedAssetId String?
  affectedEntity  String?
  assetClass      String?
  sector          String?
  country         String?
  direction       SignalDirection
  severity        SignalSeverity
  confidence      Decimal            @db.Decimal(5, 4)
  summary         String
  rawPayload      Json
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  affectedAsset   Asset?             @relation(fields: [affectedAssetId], references: [id], onDelete: SetNull)
  scannerLinks    ScannerEventLink[]

  @@index([eventType])
  @@index([occurredAt])
  @@index([detectedAt])
  @@index([affectedAssetId])
  @@index([sourceProvider])
}

model ScannerEventLink {
  id              String        @id @default(cuid())
  scannerSignalId String
  marketEventId   String
  createdAt       DateTime      @default(now())
  scannerSignal   ScannerSignal @relation(fields: [scannerSignalId], references: [id], onDelete: Cascade)
  marketEvent     MarketEvent   @relation(fields: [marketEventId], references: [id], onDelete: Cascade)

  @@unique([scannerSignalId, marketEventId])
  @@index([marketEventId])
}
